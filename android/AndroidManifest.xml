<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fieldledger.farm"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Needed only to check for and download app updates. Ledger data never leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the in-app updater hand a downloaded update to Android's package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="FieldLedger"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".FilesProvider"
            android:authorities="com.fieldledger.farm.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
